# Copy to .env only on the remote Docker host. Never commit real secrets.
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
OPENAI_API_KEY=replace-with-openrouter-key
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Network. Only OPEN_WEBUI_PORT is published to the host by docker-compose.
OPEN_WEBUI_PORT=3000
# Maximum time Open WebUI waits for one external MCP tool call. Keep this above
# the worst-case quality workflow duration.
AIOHTTP_CLIENT_TIMEOUT_TOOL_SERVER=900
QUALITY_MCP_PORT=8100
MEMORY_MCP_PORT=8101

# Chroma chat collection. 
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_MEMORY_COLLECTION=user_chat_memory

# Caller isolation. Configure both Open WebUI MCP connections with:
# {"X-OpenWebUI-User-Id": "{{USER_ID}}"}
USER_ID_HEADER=X-OpenWebUI-User-Id
REQUIRE_USER_ID_HEADER=true
# Used only when REQUIRE_USER_ID_HEADER=false for local development.
DEFAULT_USER_ID=development-only

# OpenRouter models
REFINER_MODEL=mistralai/mistral-small-24b-instruct-2501
RESPONDER_MODEL=deepseek/deepseek-v4-pro
EVALUATOR_MODEL=openai/gpt-5.6-luna-pro
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Empty means use REFINER_MODEL.
MEMORY_MODEL=mistralai/mistral-small-24b-instruct-2501

# Quality policy and capacity
MAX_ITERATIONS=3
MAX_ITERATIONS_CAP=6
AGREEMENT_SCORE=9
MAX_CONCURRENT_PIPELINES=2
MEMORY_SCORE_THRESHOLD=8
DECISION_SCORE_THRESHOLD=4

# Memory policy
RECALL_RESULTS=3
RECALL_MAX_DISTANCE=0.60
DEDUP_MAX_DISTANCE=0.05
MEMORY_LIST_MAX_RESULTS=50
MEMORY_DELETE_RETENTION_DAYS=30

# Outbound resilience and optional evaluator/responder web search
LLM_TIMEOUT=60
LLM_MAX_RETRIES=4
WEB_SEARCH_AGENTS=
WEB_SEARCH_ENGINE=auto
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_TOTAL_RESULTS=10

# Diagnostics.  
LOG_LEVEL=INFO
